# URL publique du site (balises canoniques / Open Graph)
NEXT_PUBLIC_SITE_URL=https://eventbridge.example.com

# Réception des demandes de test gratuit (cumulables).
# Sans aucun canal, les demandes sont seulement écrites dans les logs du serveur.
# 1) Webhook JSON (Make, n8n, Zapier, Slack…)
LEAD_WEBHOOK_URL=
# 2) Email via Resend
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=contact@exemple.fr
LEAD_FROM_EMAIL="EventBridge <noreply@votre-domaine.fr>"
